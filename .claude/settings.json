{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(bundle install:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle exec brakeman:*)",
      "Bash(bin/rails routes:*)",
      "Bash(bin/rails runner:*)",
      "Bash(bin/rails db:prepare:*)",
      "Bash(bin/rails db:migrate:*)",
      "Bash(bin/rails db:migrate:status:*)",
      "Bash(bin/rails db:seed:*)",
      "Bash(bin/rails db:schema:load:*)",
      "Bash(bin/rails -v:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git fetch:*)",
      "Bash(git blame:*)",
      "Bash(git stash list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(curl -s http://localhost:3000/*)",
      "Bash(curl -s -H * http://localhost:3000/*)",
      "Read(//Users/alexandrebouhid/Documents/colmeia/**)",
      "Read(//Users/alexandrebouhid/Documents/colmeia-*/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(bin/rails db:drop:*)",
      "Bash(bin/rails db:reset:*)",
      "Bash(rm -rf:*)",
      "Read(./api/config/master.key)",
      "Read(./api/config/credentials.yml.enc)",
      "Read(./**/.env)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
